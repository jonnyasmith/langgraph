# Copy to .env and fill in. .env is gitignored; this file is not.
# The local backend needs no key — it needs a model served at OLLAMA_BASE_URL.
# The hosted backend needs ANTHROPIC_API_KEY. A run only requires the key for the
# backend it actually routes to.
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
